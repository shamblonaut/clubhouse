<link rel="stylesheet" href="/css/views/home.css">

<%- include("partials/header.ejs", {
navLink: isAuthenticated ? "/logout" : "/login",
showMemberStatus: true,
isAuthenticated,
isMember,
}) %>

<section>
  <div class="hero">
    <img src="/logo.svg" alt="ClubHouse Logo" class="logo">
    <h1>Welcome to ClubHouse!</h1>
    <p>Share your random thoughts with like-minded members</p>
    <% if (!isAuthenticated) { %>
    <a href="/signup">Join ClubHouse</a>
    <% } else { %>
    <div class="new-post">
      <div class="post-header">
        <img src="<%= user.avatar_url %>" alt="Avatar of <%= user.full_name %>">
        <p><%= user.full_name %></p>
      </div>
      <form action="/post" method="POST" class="post-form">
        <textarea id="post-content"
                  name="content"
                  placeholder="What's on your mind?"
                  rows="1"
                  required></textarea>
        <button>Post</button>
      </form>
    </div>
    <% } %>
  </div>
</section>

<section>
  <ul>
    <% posts.forEach((post) => { %>
    <li class="post">
      <% if (isMember) { %>
      <div class="post-header">
        <img src="<%= post.author_avatar_url %>"
             alt="Avatar of <%= post.author_full_name %>">
        <p><%= post.author_full_name %></p>
      </div>
      <% } else { %>
      <div class="post-header">
        <img src="https://cdn-icons-png.flaticon.com/512/17561/17561717.png"
             alt="Post author avatar">
        <p>Anonymous</p>
      </div>
      <% } %>
      <p class="post-content"><%= post.content %></p>
      <div class="post-interactions">
        <button>
          <div class="icon">👍</div>
          <div class="unit"><%= post.likes %></div>
        </button>
        <button>
          <div class="icon">👎</div>
          <div class="unit"><%= post.dislikes %></div>
        </button>
      </div>
    </li>
    <% }); %>
  </ul>
</section>

<script src="/js/member.js"></script>

<%- contentFor("title") %>
ClubHouse | Home
