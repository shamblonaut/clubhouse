<link rel="stylesheet" href="/css/views/home.css">

<%- include("partials/header.ejs", {
navLink: isAuthenticated ? { href: "/logout", content: "Logout"} : { href: "/login", content: "Login" },
showMemberStatus: true,
isAuthenticated,
isMember,
}) %>

<section>
  <div class="hero">
    <img src="/logo.svg" alt="ClubHouse Logo" class="logo">
    <h1>Welcome to ClubHouse!</h1>
    <p>Share your random thoughts with like-minded members</p>
    <% if (!isAuthenticated) { %>
    <a href="/signup">Join ClubHouse</a>
    <% } else { %>
    <div class="new-post">
      <div class="post-header">
        <img src="<%= user.avatar_url %>"
             alt="Avatar of <%= user.full_name %>"
             class="post-author-avatar">
        <p class="post-author"><%= user.full_name %></p>
      </div>
      <form action="/post" method="POST" class="post-form">
        <textarea id="post-content"
                  name="content"
                  placeholder="What's on your mind?"
                  rows="1"
                  required></textarea>
        <button>Post</button>
      </form>
    </div>
    <% } %>
  </div>
</section>

<section>
  <ul>
    <% posts.forEach((post) => { %>
    <li class="post">
      <% if (isAdmin || isMember || post.author_id === user?.id) { %>
      <div class="post-header">
        <img src="<%= post.author_avatar_url %>"
             alt="Avatar of <%= post.author_full_name %>"
             class="post-author-avatar">
        <p class="post-author"><%= post.author_full_name %></p>

        <%
        const currentYear = (new Date()).getFullYear().toString();
        const [_, postMonth, postDate, postYear] = post.created_at.toDateString().split(" ");
        const dateString =
        `${postMonth} ${postDate}` +
        (postYear === currentYear ? "" : ` ${postYear}`);
        %>
        <p class="post-date"><%= dateString %></p>

        <% if (isAdmin) { %>
        <button class="delete-post" data-post_id="<%= post.id %>">
          <svg xmlns="http://www.w3.org/2000/svg"
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="lucide lucide-trash">
            <path d="M10 11v6" />
            <path d="M14 11v6" />
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
            <path d="M3 6h18" />
            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          </svg>
        </button>
        <% } %>
      </div>
      <% } else { %>
      <div class="post-header">
        <img src="https://cdn-icons-png.flaticon.com/512/17561/17561717.png"
             alt="Post author avatar"
             class="post-author-avatar">
        <p class="post-author">Anonymous</p>
      </div>
      <% } %>
      <p class="post-content"><%= post.content %></p>
      <div class="post-interactions"
           data-vote="<%= reactions[post.id].user_reaction %>">
        <button class="like" data-post_id="<%= post.id %>">
          <div class="icon">👍</div>
          <div class="count"><%= reactions[post.id].likes %></div>
        </button>
        <button class="dislike" data-post_id="<%= post.id %>">
          <div class="icon">👎</div>
          <div class="count"><%= reactions[post.id].dislikes %></div>
        </button>
      </div>
    </li>
    <% }); %>
  </ul>
</section>

<script src="/js/member.js"></script>
<script src="/js/reactions.js"></script>
<% if (isAdmin) { %>
<script src="/js/admin.js"></script>
<% } %>

<%- contentFor("title") %>
ClubHouse | Home
